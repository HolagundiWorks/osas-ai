# Copy to .env and fill in on the training machine. Do not commit .env.
# HF_TOKEN is optional for public models and is read from the environment only.
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
# MYNA_TRAIN_PATH=/data/myna/train.jsonl
# MYNA_VALIDATION_PATH=/data/myna/validation.jsonl
# MYNA_OUTPUT_DIR=/data/myna/outputs
# MYNA_MODEL_DIR=/data/myna/models/olmo3-7b-instruct
# LLAMA_CPP_CONVERT=/opt/llama.cpp/convert_hf_to_gguf.py
